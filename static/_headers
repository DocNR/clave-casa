# Cloudflare Pages custom headers (https://developers.cloudflare.com/pages/configuration/headers/)
#
# Files in static/ ship to the deploy verbatim; this file overrides the
# default Content-Type for the AASA file, which has no extension and would
# otherwise be served as application/octet-stream — iOS swcd silently
# rejects anything that isn't application/json. Apple's AASA validator
# fails the same way. This is the single most-common AASA setup gotcha.

/.well-known/apple-app-site-association
  Content-Type: application/json
  Cache-Control: public, max-age=3600

/.well-known/nostr.json
  Content-Type: application/json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300

# Connect with Clave SDK. The unversioned file is "latest" (short cache);
# versioned copies never change, so partners pinning a version + SRI hash get
# immutable caching. Served cross-origin — partners load it from their own site.
/sdk/clave-connect.js
  Content-Type: text/javascript; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300

/sdk/clave-connect-*.js
  Content-Type: text/javascript; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=31536000, immutable

/brand/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=86400
